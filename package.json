{
  "name": "agent-annotations-monorepo",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.10.0",
  "scripts": {
    "pack:agent-annotations": "cd packages/agent-annotations && pnpm pack",
    "pack:receiver": "cd packages/agent-annotations-receiver && pnpm pack",
    "package:extension": "python scripts/package-extension-zip.py",
    "test:extension": "node --test tests/extension/*.test.mjs",
    "test:extension:browser": "node tests/browser/extension-journey.mjs"
  }
}
